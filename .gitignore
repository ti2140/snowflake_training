# Terraformプロバイダーバイナリ（容量が大きくGit管理不要）
terraform/.terraform/
terraform/providers/

# stateファイル（Terraform Cloudで管理するため除外）
.terraform.lock.hcl
*.tfstate
*.tfstate.backup

# 認証情報を含む変数ファイル
terraform/*.tfvars

# 公開鍵・秘密鍵
*.p8
*.pem
*.key
*.pub

# .venvフォルダ
dbt/.venv/
__pycache__/
*.pyc

# dbt接続情報（作業開始前に追加）
dbt/profiles.yml

# デバッグスクリプト
dbt/mydbt/macros/debug_s3_integration.sql